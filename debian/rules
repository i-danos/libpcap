#!/usr/bin/make -f

DEB_HOST_ARCH_OS := $(shell dpkg-architecture -qDEB_HOST_ARCH_OS)

ifeq ($(DEB_HOST_ARCH_OS),linux)
export with_pcap=linux
endif
ifeq ($(DEB_HOST_ARCH_OS),kfreebsd)
export with_pcap=bpf
endif
ifeq ($(DEB_HOST_ARCH_OS),hurd)
export with_pcap=hurd
endif

%:
	dh $@ --with autoreconf

# configure's libnl V_INCLS accumulator ends up empty in the generated
# Makefile despite nl-3 detection succeeding (an upstream autoconf ordering
# quirk), and the generated Makefile's CPPFLAGS is a plain make variable
# that configure never substitutes a value into -- so the include path has
# to be injected at build time on the make command line, not via configure.
override_dh_auto_build:
	dh_auto_build -- CPPFLAGS="-I/usr/include/libnl3"

override_dh_install-arch:
	dh_install --fail-missing
	# pcap-filter man page goes into libpcap0.8 (#527599)
	rm debian/libpcap0.8-dev/usr/share/man/man7/pcap-filter.7

override_dh_strip-arch:
	dh_strip --dbg-package=libpcap0.8-dbg

override_dh_makeshlibs-arch:
	dh_makeshlibs -- -c4
